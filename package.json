{
  "name": "@kugouming/ghostty-web",
  "version": "0.5.0",
  "description": "Web-based terminal emulator using Ghostty's VT100 parser via WebAssembly (fork of coder/ghostty-web, published as @kugouming/ghostty-web)",
  "type": "module",
  "main": "./dist/ghostty-web.umd.cjs",
  "module": "./dist/ghostty-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ghostty-web.js",
      "require": "./dist/ghostty-web.umd.cjs"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm"
  },
  "files": [
    "dist",
    "ghostty-vt.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "terminal",
    "terminal-emulator",
    "ghostty",
    "web",
    "xterm",
    "vt100",
    "wasm",
    "webassembly",
    "ansi",
    "tty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kugouming/crafter-terminal.git"
  },
  "bugs": "https://github.com/kugouming/crafter-terminal/issues",
  "homepage": "https://github.com/kugouming/crafter-terminal#readme",
  "license": "MIT",
  "author": "kugouming",
  "contributors": [
    "Coder (https://github.com/coder) - original ghostty-web project"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port 8000",
    "demo": "node demo/bin/demo.js",
    "demo:dev": "node demo/bin/demo.js --dev",
    "build": "bun run clean && bun run build:wasm && bun run build:lib && bun run build:wasm-copy",
    "build:publish": "bun run clean && bun run build:lib && bun run build:wasm-copy",
    "build:wasm": "./scripts/build-wasm.sh",
    "build:font-metrics": "python3 scripts/build-font-metrics.py demo/fonts/MapleMono-Regular.woff2 --family \"Maple Mono\" -o demo/fonts/MapleMono-metrics.json",
    "build:lib": "vite build",
    "build:wasm-copy": "cp ghostty-vt.wasm dist/",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write --cache .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "bun run build:publish",
    "prepack": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^15.11.0",
    "@types/bun": "^1.3.2",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "mitata": "^1.0.34",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
