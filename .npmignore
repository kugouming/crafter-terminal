docs/
scripts/
lib/**/*.test.ts
.github/
patches/
bench/
flake.nix
flake.lock
happydom.ts
bunfig.toml
.git*
*.log
node_modules/
bun.lock
AGENTS.md
vite.config.js
tsconfig.json
biome.json
.prettierrc
.prettierignore
