# Default configuration for the crafter-terminal demo.
#
# The demo applies this config first and then layers your local
# ~/.config/ghostty/config on top of it (see demo/bin/demo.js), so the web
# terminal renders the same everywhere while still mirroring your own terminal
# on machines that have one configured.
#
# The font below is bundled with the demo (demo/fonts, SIL OFL 1.1) and loaded
# with @font-face, so the glyphs and the cell metrics do not depend on which
# fonts happen to be installed.
#
# Format: this is a regular Ghostty config file, parsed by
# lib/ghostty-config.ts. Run the demo with a different one by setting
# GHOSTTY_CONFIG=<path>.

# --- Typography ---
font-family = Maple Mono
font-size = 14
adjust-cell-height = 2

# --- Theme: Catppuccin Mocha palette, on the demo's original background ---
# The palette and foreground come from Catppuccin Mocha; the background stays
# the dark grey the demo has always used (#1e1e1e) instead of Mocha's #1e1e2e.
# Because this file is applied after the theme file, these values win over a
# local `theme = ...` setting.
background = #1e1e1e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e1e
selection-background = #585b70
selection-foreground = #cdd6f4
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f37799
palette = 10=#89d88b
palette = 11=#ebd391
palette = 12=#74a8fc
palette = 13=#f2aede
palette = 14=#6bd7ca
palette = 15=#bac2de

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true

# --- Window ---
window-padding-x = 10
window-padding-y = 8
